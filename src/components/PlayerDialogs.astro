---

---

<div id="player-dialogs">
  <dialog class="modal" data-edit-dialog>
    <form class="score-form">
      <h2>Ajustar jugador</h2>
      <label>
        Nombre jugador
        <input name="name" type="text" maxlength="24" required />
      </label>
      <label>
        Puntuación
        <input name="score" type="number" min="0" step="1" required />
      </label>
      <label>
        Poder
        <input name="power" type="number" min="1" step="1" required />
      </label>
      <p class="status" data-edit-status></p>
      <div class="modal__actions">
        <button type="button" class="btn" data-close-dialog>Cancelar</button>
        <button type="submit" class="btn btn--primary">Guardar cambios</button>
      </div>
    </form>
  </dialog>

  <dialog class="modal" data-delete-dialog>
    <div class="modal__body">
      <h2>¿Sacar del flock?</h2>
      <p>
        Se eliminará a <strong data-delete-name></strong>. Esta acción no se
        puede deshacer.
      </p>
      <div class="modal__actions">
        <button type="button" class="btn" data-close-dialog>Cancelar</button>
        <button type="button" class="btn btn--danger" data-confirm-delete
          >Eliminar</button
        >
      </div>
    </div>
  </dialog>

  <dialog class="modal" data-clear-dialog>
    <div class="modal__body">
      <h2>¿Vaciar todo el flock?</h2>
      <p>
        Se eliminarán <strong>todos los miembros</strong> registrados. Esta acción no se puede deshacer.
      </p>
      <div class="modal__actions">
        <button type="button" class="btn" data-close-dialog>Cancelar</button>
        <button type="button" class="btn btn--danger" data-confirm-clear
          >Sí, vaciar todo</button
        >
      </div>
    </div>
  </dialog>
</div>

<style>
  dialog.modal {
    position: fixed;
    inset: 0;
    margin: auto !important;
    border: 4px solid var(--ab-wood);
    border-radius: 24px;
    padding: 22px;
    background: var(--ab-cream);
    width: min(420px, calc(100vw - 32px));
    max-width: calc(100vw - 32px);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    box-shadow: 0 16px 36px rgba(30, 20, 10, 0.45);
    z-index: 100;
  }

  dialog.modal::backdrop {
    background: rgba(30, 20, 10, 0.65);
    backdrop-filter: blur(4px);
  }

  .modal__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .modal__body h2 {
    margin: 0;
    font-family: "Luckiest Guy", Fredoka, sans-serif;
    color: var(--ab-wood);
  }

  .modal__body p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.4;
  }

  .modal__actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 10px;
  }
</style>
