<nav id="view-tabs" class="view-tabs" role="tablist" aria-label="Secciones principales">
  <button
    type="button"
    class="view-tab is-active"
    role="tab"
    aria-selected="true"
    aria-controls="player-board"
    data-tab-target="player-board"
  >
    <span class="view-tab__icon">🏆</span>
    <span class="view-tab__label">El Flock</span>
    <span class="view-tab__badge" data-tab-flock-count>0</span>
  </button>

  <button
    type="button"
    class="view-tab"
    role="tab"
    aria-selected="false"
    aria-controls="table-export"
    data-tab-target="table-export"
  >
    <span class="view-tab__icon">🎨</span>
    <span class="view-tab__label">Generar Imagen</span>
  </button>
</nav>
